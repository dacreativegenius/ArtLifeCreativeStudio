{
  "id": "./",
  "name": "Art Life Creative Studio",
  "short_name": "Art Life",
  "description": "Pressure-sensitive pencil and vector drawing studio",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#222226",
